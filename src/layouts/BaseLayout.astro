---
import '../styles/global.css';

interface NavigationItem {
	label: string;
	href: string;
}

interface ContactDetails {
	email: string;
	whatsappUrl: string;
	whatsappText: string;
	instagramUrl: string;
	instagramHandle: string;
}

interface LanguageOption {
	code: string;
	label: string;
	name: string;
}

interface LocaleTranslation {
	siteTagline: string;
	headerCtaLabel: string;
	footerContactLabel: string;
	emailLabel: string;
	whatsappLabel: string;
	instagramLabel: string;
	footerNote: string;
	copyright: string;
	navigation: NavigationItem[];
}

interface Props {
	title: string;
	description: string;
	siteName: string;
	contact: ContactDetails;
	rootPath?: string;
	defaultLocale: string;
	languages: LanguageOption[];
	translations: Record<string, LocaleTranslation>;
}

const {
	title,
	description,
	siteName,
	contact,
	rootPath = '',
	defaultLocale,
	languages,
	translations,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const resolveHref = (href: string) => (href.startsWith('#') ? `${rootPath}${href}` : href);
const localeOptions = languages.filter((language) => translations[language.code]);

if (!localeOptions.length) {
	throw new Error('BaseLayout requires at least one language with matching localized site settings.');
}
---

<!doctype html>
<html lang={defaultLocale} data-lang={defaultLocale} data-theme="caminito">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=Bodoni+Moda:opsz,wght@6..96,700;6..96,800;6..96,900&family=Inter:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href={rootPath || '/'}>
					<span class="brand__kicker">Buenos Aires</span>
					<span class="brand__name">{siteName}</span>
					{localeOptions.map((language) => (
						<span class="locale-block brand__tagline" data-locale={language.code}>
							{translations[language.code].siteTagline}
						</span>
					))}
				</a>

				{localeOptions.map((language) => (
					<div class="locale-flex site-header__row" data-locale={language.code}>
						<nav class="site-nav" aria-label="Primary">
							{translations[language.code].navigation.map((item) => (
								<a href={resolveHref(item.href)}>{item.label}</a>
							))}
						</nav>
						<a class="button button--compact" href={resolveHref('#contact')}>
							{translations[language.code].headerCtaLabel}
						</a>
					</div>
				))}

				<div class="language-switcher" aria-label="Language switcher">
					{localeOptions.map((language) => (
						<button
							type="button"
							class="language-switcher__button"
							data-lang-switch={language.code}
							aria-pressed={language.code === defaultLocale ? 'true' : 'false'}
						>
							{language.label}
						</button>
					))}
				</div>
			</header>
			<slot />
			<footer class="site-footer">
				{localeOptions.map((language) => (
					<div class="locale-grid site-footer__locale" data-locale={language.code}>
						<div class="footer-card">
							<p class="eyebrow">{translations[language.code].footerContactLabel}</p>
							<ul class="footer-links">
								<li>
									<a href={`mailto:${contact.email}`}>
										{translations[language.code].emailLabel}: {contact.email}
									</a>
								</li>
								<li>
									<a href={contact.whatsappUrl} target="_blank" rel="noreferrer">
										{translations[language.code].whatsappLabel}: {contact.whatsappText}
									</a>
								</li>
								<li>
									<a href={contact.instagramUrl} target="_blank" rel="noreferrer">
										{translations[language.code].instagramLabel}: {contact.instagramHandle}
									</a>
								</li>
							</ul>
						</div>
						<div class="footer-card">
							<p>{translations[language.code].footerNote}</p>
							<p class="footer-meta">{translations[language.code].copyright}</p>
						</div>
					</div>
				))}
			</footer>
		</div>


		<!-- ITERATION ONLY: theme switcher. Delete this block, the .theme-switcher
		     CSS, and the two unused :root theme blocks once a direction is picked. -->
		<div class="theme-switcher" aria-label="Theme proposals">
			<button type="button" data-theme-switch="caminito" aria-pressed="true">Caminito</button>
			<button type="button" data-theme-switch="fileteado" aria-pressed="false">Fileteado</button>
			<button type="button" data-theme-switch="mercado" aria-pressed="false">Mercado</button>
		</div>
		<script is:inline>
			document.querySelectorAll('[data-theme-switch]').forEach((button) => {
				button.addEventListener('click', () => {
					const theme = button.dataset.themeSwitch;
					document.documentElement.dataset.theme = theme;
					window.localStorage.setItem('abrazo-theme', theme);
					document.querySelectorAll('[data-theme-switch]').forEach((other) => {
						other.setAttribute('aria-pressed', other.dataset.themeSwitch === theme ? 'true' : 'false');
					});
				});
			});
			const themeParam = new URLSearchParams(window.location.search).get('theme');
			const initialTheme = themeParam ?? window.localStorage.getItem('abrazo-theme');
			if (initialTheme) {
				document.querySelector(`[data-theme-switch="${initialTheme}"]`)?.click();
			}
		</script>

		<script is:inline define:vars={{ defaultLocale, localeCodes: localeOptions.map((item) => item.code) }}>
			const params = new URLSearchParams(window.location.search);
			const stored = window.localStorage.getItem('abrazo-lang');
			const browser = navigator.language.slice(0, 2).toLowerCase();
			const initialLocale = [params.get('lang'), stored, browser, defaultLocale].find((candidate) =>
				localeCodes.includes(candidate ?? ''),
			) ?? defaultLocale;

			const applyLocale = (locale) => {
				document.documentElement.lang = locale;
				document.documentElement.dataset.lang = locale;
				window.localStorage.setItem('abrazo-lang', locale);

				document.querySelectorAll('[data-lang-switch]').forEach((button) => {
					button.setAttribute('aria-pressed', button.dataset.langSwitch === locale ? 'true' : 'false');
				});

				const nextUrl = new URL(window.location.href);
				nextUrl.searchParams.set('lang', locale);
				window.history.replaceState({}, '', nextUrl);
			};

			document.querySelectorAll('[data-lang-switch]').forEach((button) => {
				button.addEventListener('click', () => applyLocale(button.dataset.langSwitch));
			});

			applyLocale(initialLocale);
		</script>
	</body>
</html>
